<!--
  LOCAL-SERVICES probe v2 (task LOCAL-SERVICES-PROBE-V2), cases SVC-002/003/004.

  Declared components:
    .ControlActivity      MAIN/LAUNCHER, exported; stays alive for the whole run
                          and emits one aggregate SVC_JSON_BEGIN/END block.
    .SvcStartIds          SVC-002 service under test ("component A").
    .SvcReturnValues      SVC-003 service under test ("component A").
    .SvcSelfStop          SVC-004 service under test ("component A").

  Each scenario uses a distinct service class so it always gets a fresh
  instance, independent of whether the previous scenario's onDestroy landed.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.atl.tests.svc">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <application
        android:label="ATL LOCAL-SERVICES probe v2"
        android:debuggable="true">
        <activity
            android:name=".ControlActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".SvcStartIds"
            android:exported="false" />
        <service
            android:name=".SvcReturnValues"
            android:exported="false" />
        <service
            android:name=".SvcSelfStop"
            android:exported="false" />
    </application>
</manifest>
