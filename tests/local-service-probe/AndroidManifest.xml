<!--
  LOCAL-SERVICES probe v5 (task LOCAL-SERVICES-PROBE-V5), cases SVC-002..SVC-017.
  = v4 (SVC-002..016) + appended SVC-012/013c-bounded/014/015/017.

  Declared components:
    .ControlActivity      MAIN/LAUNCHER, exported; stays alive for the whole run
                          and emits one aggregate SVC_JSON_BEGIN/END block.
    .SvcStartIds          SVC-002 service under test ("component A").
    .SvcReturnValues      SVC-003 service under test ("component A").
    .SvcSelfStop          SVC-004 service under test ("component A").
    .SvcBinder            SVC-005/006/007 component B (onBind returns a binder).
    .SvcUnbindFalse       SVC-008a component Bf (onUnbind returns false).
    .SvcUnbindTrue        SVC-008b component Bt (onUnbind returns true + onRebind).
    .SvcNullBind          SVC-009 component Bn (onBind returns null).
    .SvcV4B               SVC-010/011 component B (logs onStartCommand too).
    .SvcStopSelfV4        SVC-016 component A (stopSelfResult/stopSelf current id).
    .SvcReenterStart      SVC-013a Ir (onStartCommand -> startService).
    .SvcReenterBind       SVC-013b Ir2 (client unbinds from onServiceConnected).
    .SvcReenterUnbind     SVC-013c Ir3 (onUnbind -> bindService).

  v2 scenarios use a distinct service class so each always gets a fresh instance;
  the binding scenarios reset the instance index on onDestroy so each fresh
  instance is instance=1 per the specs' planned traces.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.atl.tests.svc">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <application
        android:label="ATL LOCAL-SERVICES probe v5"
        android:debuggable="true">
        <activity
            android:name=".ControlActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".SvcStartIds"
            android:exported="false" />
        <service
            android:name=".SvcReturnValues"
            android:exported="false" />
        <service
            android:name=".SvcSelfStop"
            android:exported="false" />
        <service
            android:name=".SvcBinder"
            android:exported="false" />
        <service
            android:name=".SvcUnbindFalse"
            android:exported="false" />
        <service
            android:name=".SvcUnbindTrue"
            android:exported="false" />
        <service
            android:name=".SvcNullBind"
            android:exported="false" />
        <service
            android:name=".SvcV4B"
            android:exported="false" />
        <service
            android:name=".SvcStopSelfV4"
            android:exported="false" />
        <service
            android:name=".SvcReenterStart"
            android:exported="false" />
        <service
            android:name=".SvcReenterBind"
            android:exported="false" />
        <service
            android:name=".SvcReenterUnbind"
            android:exported="false" />
        <!-- v5 components -->
        <service
            android:name=".SvcUnbindTrueStarted"
            android:exported="false" />
        <service
            android:name=".SvcCycles"
            android:exported="false" />
        <service
            android:name=".SvcRemote"
            android:exported="false"
            android:process=":remote" />
    </application>
</manifest>
