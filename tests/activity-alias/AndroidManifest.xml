<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.atl.activityalias">
 <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28"/>
 <application>
  <activity android:name=".Starter" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <activity android:name=".Target" android:exported="true" android:launchMode="singleTop"/>
  <activity-alias android:name=".Alias" android:targetActivity=".Target" android:exported="true">
   <intent-filter><action android:name="org.atl.activityalias.OPEN"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
  </activity-alias>
 </application>
</manifest>
