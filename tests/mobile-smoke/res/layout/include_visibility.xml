<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <include android:id="@+id/hidden" android:visibility="gone" layout="@layout/include_child_visible" />
    <include android:id="@+id/invisible" android:visibility="invisible" layout="@layout/include_child_visible" />
    <include android:id="@+id/visible" android:visibility="visible" layout="@layout/include_child_invisible" />
    <include android:id="@+id/inherited" layout="@layout/include_child_invisible" />
    <include android:visibility="gone" layout="@layout/include_child_merge" />
</LinearLayout>
