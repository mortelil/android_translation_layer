<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.atl.shortcutmanager">
	<uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28"/>
	<application>
		<activity android:name=".Probe" android:exported="true" android:configChanges="orientation|screenSize">
			<meta-data android:name="probe" android:value="activity"/>
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>
	</application>
</manifest>
